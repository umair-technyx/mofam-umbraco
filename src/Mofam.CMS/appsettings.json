{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient"
  },
  "Security": {
    "ApiKey": "REPLACE_WITH_A_STRONG_RANDOM_API_KEY"
  },
  "RateLimit": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Search": {
    "IndexName": "ExternalIndex",
    "SearchableFields": [
      "nodeName",
      "title",
      "description"
    ],
    "AllowedContentTypes": [],
    "MaxPageSize": 50,
    "ImageFieldAliases": [
      "thumbnailImageWeb",
      "thumbnailImage",
      "image"
    ]
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Sentry": {
    "Enabled": false,
    "AppName": "Mofam",
    "Dsn": "",
    "MinimumEventLevel": "Warning"
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "aad2744a-6469-4c4f-8985-0bfc5267ba5d",
        "UseHttps": true,
        "SanitizeTinyMce": true,
        "MainDomLock": "FileSystemMainDomLock"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false,
        "UserPassword": {
          "RequiredLength": 8,
          "RequireDigit": true,
          "RequireLowercase": true,
          "RequireUppercase": true,
          "RequireNonLetterOrDigit": true,
          "HashAlgorithmType": "PBKDF2.ASPNETCORE.V3",
          "MaxFailedAccessAttemptsBeforeLockout": 5
        },
        "MemberPassword": {
          "RequiredLength": 10,
          "RequireDigit": true,
          "RequireLowercase": true,
          "RequireUppercase": true,
          "RequireNonLetterOrDigit": true,
          "HashAlgorithmType": "PBKDF2.ASPNETCORE.V3",
          "MaxFailedAccessAttemptsBeforeLockout": 3
        }
      },
      "Imaging": {
        "HMACSecretKey": ""
      },
      "DeliveryApi": {
        "Enabled": false
      },
      "WebRouting": {
        "DisableRedirectUrlTracking": true
      }
    }
  }
}
