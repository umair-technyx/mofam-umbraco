{
  "$schema": "appsettings-schema.json",
  "AllowedHosts": "",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  },
  "LogStorage": {
    "ConnectionString": "",
    "ContainerName": "logs",
    "UmbracoContainerName": "umbraco-logs"
  },
  "KeyVault": {
    "URL": "",
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": ""
  },
  "BackOfficeEntraId": {
    "Enabled": true,
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "Authority": "",
    "CallbackPath": "",
    "SignedOutCallbackPath": "",
    "ResponseMode": "query",
    "AllowManualLinking": false,
    "DenyLocalLogin": true,
    "AutoRedirect": false,
    "ExtraGroups": {
      "admin": [ "sensitiveData" ],
      "editor": [ "translator" ]
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient"
  },
  "Security": {
    "ApiKey": ""
  },
  "RateLimit": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "SignInPermitLimit": 20,
    "SignInWindowSeconds": 60
  },
  "Cache": {
    "Enabled": true,
    "SiteRootSeconds": 300,
    "FilterSeconds": 300,
    "PageSeconds": 60,
    "StartupSeconds": 300
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Sentry": {
    "Enabled": false,
    "AppName": "Mofam",
    "Dsn": "",
    "MinimumEventLevel": "Warning"
  },
  "Umbraco": {
    "Storage": {
      "AzureBlob": {
        "Media": {
          "ConnectionString": "",
          "ContainerName": ""
        }
      }
    },
    "CMS": {
      "Global": {
        "Id": "aad2744a-6469-4c4f-8985-0bfc5267ba5d",
        "UseHttps": true,
        "SanitizeTinyMce": true,
        "MainDomLock": "FileSystemMainDomLock"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "LoginLogoImage": "assets/logo_dark.svg",
        "LoginLogoImageAlternative": "assets/logo_dark.svg",
        "LoginBackgroundImage": "assets/images/login-bg.svg",
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false,
        "UserPassword": {
          "RequiredLength": 8,
          "RequireDigit": true,
          "RequireLowercase": true,
          "RequireUppercase": true,
          "RequireNonLetterOrDigit": true,
          "HashAlgorithmType": "PBKDF2.ASPNETCORE.V3",
          "MaxFailedAccessAttemptsBeforeLockout": 5
        },
        "MemberPassword": {
          "RequiredLength": 10,
          "RequireDigit": true,
          "RequireLowercase": true,
          "RequireUppercase": true,
          "RequireNonLetterOrDigit": true,
          "HashAlgorithmType": "PBKDF2.ASPNETCORE.V3",
          "MaxFailedAccessAttemptsBeforeLockout": 3
        }
      },
      "Imaging": {
        "HMACSecretKey": ""
      },
      "DeliveryApi": {
        "Enabled": false
      },
      "WebRouting": {
        "DisableRedirectUrlTracking": true
      }
    }
  }
}
