<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mofam.Domain\Mofam.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="SendGrid" />
    <PackageReference Include="Google.Cloud.RecaptchaEnterprise.V1" />
  </ItemGroup>

  <!-- Some types, like IPublishedContentQuery, are not in the Umbraco.Cms.Core package.
       Their implementations are in the Umbraco.Cms.Infrastructure package, so both packages are needed. -->
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Core" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" />
  </ItemGroup>

</Project>
